{
  "name": "nib",
  "private": true,
  "version": "1.10.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:reader",
    "build:reader": "vite build --config vite.reader.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "LC_ALL=en_US.UTF-8 vitest run",
    "test:watch": "vitest",
    "timing": "NIB_TIMING=1 vitest run --project 'browser (chromium)'",
    "deploy": "node scripts/deploy.mjs",
    "release:web": "node scripts/release-web.mjs",
    "coin-code": "node scripts/coin-code.mjs",
    "counts": "node scripts/counts.mjs",
    "dev:worker": "npm run build:reader && wrangler dev",
    "postinstall": "node scripts/local-capacitor.mjs",
    "cap:sync": "cap sync ios && node scripts/local-capacitor.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-strike": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/html": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.2",
    "fflate": "^0.8.3",
    "katex": "0.19.1",
    "marked": "^18.0.9",
    "prosemirror-search": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "refractor": "5.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.137.0"
  }
}
