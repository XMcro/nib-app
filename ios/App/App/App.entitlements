<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iPhone and iPad only; the Mac keeps App-Mac.entitlements, with no App
     Group in this version. The group holds quick capture's inbox (NibInbox.swift),
     shared with the share extension and the widgets. iCloud's key-value store
     keeps the stamps (NibCloudPlugin.swift), the same one as the Mac's. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.nib.ios</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
