{
  "manifest_version": 3,
  "name": "Nib Web Clipper",
  "version": "0.0.0",
  "description": "Save a web page, an article or a selection to Nib. Each clip is encrypted in your browser before it is sent.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Save to Nib",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://sync.nibprivacy.com/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@nibprivacy.com",
      "strict_min_version": "127.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"] }
    }
  }
}
